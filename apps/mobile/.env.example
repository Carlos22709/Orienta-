# Copia este archivo como .env (no se versiona) y completa los valores.
# En el teléfono no uses localhost: usa la IP de tu computador en la red local.

# URL base de la API propia (Edge Function "api"), terminada en /api.
#   Con Supabase local (npx supabase start):  http://<IP-del-computador>:54321/functions/v1/api
#   Solo la función (npm run api:serve):       http://<IP-del-computador>:8787/api
EXPO_PUBLIC_API_URL=

# Supabase Auth (inicio de sesión y renovación de la sesión).
#   Local: http://<IP-del-computador>:54321 y la clave "Publishable" de `npx supabase status`.
#   Nube:  https://<ref>.supabase.co y la clave publishable del panel (Project Settings > API Keys).
# Nunca uses aquí la clave secret: todo lo que empieza por EXPO_PUBLIC_ queda dentro de la app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
