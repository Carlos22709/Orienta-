{
  "name": "orienta-plus",
  "private": true,
  "description": "Orienta+: herramientas del backend (Supabase CLI y Deno). La app móvil vive en apps/mobile con sus propias dependencias.",
  "scripts": {
    "supabase": "supabase",
    "api:test": "deno test --config supabase/functions/api/deno.json supabase/functions",
    "api:check": "deno check --config supabase/functions/api/deno.json supabase/functions/api/index.ts",
    "api:lint": "deno lint --config supabase/functions/api/deno.json supabase/functions",
    "api:fmt": "deno fmt --config supabase/functions/api/deno.json supabase/functions",
    "api:serve": "deno serve --port 8787 --config supabase/functions/api/deno.json supabase/functions/api/index.ts"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^3.1.0"
  }
}
