# Secretos de la Edge Function "api" para desarrollo local.
# Copia este archivo como supabase/.env (no se versiona) y genera cada valor con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cada integrante usa sus propios valores locales. Los de la nube se configuran
# aparte con `npx supabase secrets set` y nunca se comparten por chat ni Git.

# Clave AES-GCM de 32 bytes en Base64 para cifrar los secretos TOTP.
TOTP_ENCRYPTION_KEY=

# Secreto para firmar el elevated_token (HS256). Mínimo 32 caracteres.
ELEVATED_TOKEN_SECRET=
